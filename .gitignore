# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Memory store (ChromaDB binary files — large, local only)
outputs/memory/*
!outputs/memory/.gitkeep

# macOS
.DS_Store

# Environment variables
.env

# Local call logs and provenance generated by new executions
*.calls.jsonl
*.manifest.json
**/smoke_outputs/

# Supplementary rollout outputs are not part of this release
persona_free_baseline/**/outputs/
matched_one_shot/outputs/
bmrn_cross_sector/outputs/
aapl_r2/outputs/
persona_paraphrase_robustness/outputs/
